# ==================== REQUIRED SETTINGS ====================

# Hugging Face token for downloading models (REQUIRED)
# Get from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# JWT Secret for API authentication (REQUIRED for production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=generate-strong-random-secret-change-this

# Encryption key for sensitive data (REQUIRED)
# Generate with: python generate_encryption_key.py
ENCRYPTION_KEY=generate-encryption-key-change-this

# ==================== DATABASE SETTINGS ====================

# Database URL (SQLite by default, PostgreSQL for production)
# SQLite: sqlite:///securex_db.sqlite
# PostgreSQL: postgresql://user:password@host:5432/securex_db
DATABASE_URL=sqlite:///securex_db.sqlite

# For PostgreSQL, enforce SSL
DATABASE_SSL_MODE=prefer

# ==================== API SECURITY ====================

# Session secret for session management
SESSION_SECRET=generate-another-random-secret-change-this

# CORS allowed origins (comma-separated)
# Development: http://localhost:8550
# Production: https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=http://localhost:8550

# ==================== APPLICATION SETTINGS ====================

# Application metadata
APP_NAME=SecureX-Assist
APP_VERSION=1.0.0

# Security
VOICE_THRESHOLD=0.40
SESSION_TIMEOUT=3600
MAX_LOGIN_ATTEMPTS=3

# Production flag (set to true in production)
PRODUCTION=false

# ==================== AUDIO SETTINGS ====================

SAMPLE_RATE=16000
CHANNELS=1
CHUNK_SIZE=1024

# ==================== LOGGING & MONITORING ====================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
DEBUG_MODE=false

# Sentry DSN for error tracking (optional)
# Get from: https://sentry.io
SENTRY_DSN=

# ==================== OPTIONAL: EMAIL NOTIFICATIONS ====================

# SMTP settings for email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=
SMTP_USE_TLS=true

# ==================== OPTIONAL: ADVANCED SETTINGS ====================

# Performance tuning
ENABLE_CACHE=true
CACHE_SIZE=200
CACHE_TTL=3600

# Model settings
WHISPER_MODEL=tiny
USE_GPU=false

# Text-to-Speech (optional)
# Preferred system voice for fallback TTS (Windows SAPI/pyttsx3): default|female|male
SECUREX_TTS_VOICE=female

# ==================== OPTIONAL: CLOUD LLM (VOICE ASSISTANT CHAT) ====================

# Groq (recommended)
# Create a key at: https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override Groq model (defaults to llama-3.1-8b-instant)
GROQ_MODEL=llama-3.1-8b-instant

# Gemini (optional fallback)
# Create a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
